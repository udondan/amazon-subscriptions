{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "mode": "auto",
  "prHourlyLimit": 1,
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "3 days",
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Pinned to a commit of the fork with amazon.de support; changed by hand until upstream releases it.",
      "matchPackageNames": ["amazon-orders"],
      "enabled": false
    }
  ]
}
